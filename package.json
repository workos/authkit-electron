{
  "name": "@workos/authkit-electron",
  "version": "0.1.2",
  "description": "WorkOS AuthKit for Electron — main, preload, and React renderer bindings built on @workos/authkit-session.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workos/authkit-electron.git"
  },
  "files": [
    "dist",
    "src",
    "globals.d.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "default": "./dist/internals.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "rebuild": "pnpm run clean && pnpm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "npm run rebuild",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "publint": "publint",
    "attw": "attw"
  },
  "dependencies": {
    "@workos/authkit-session": "^0.6.0",
    "electron-store": "^11.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@workos-inc/node": "^10.4.0",
    "electron": "^42.5.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "publint": "^0.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@workos-inc/node": "^10.4.0",
    "electron": ">=30",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.28.0"
}
